<themeCapabilities>

    <themeName>Ergo Proxy (Revisited)</themeName>

    <aspectRatio>19.5:9</aspectRatio>
    <aspectRatio>16:9</aspectRatio>
    <aspectRatio>16:10</aspectRatio>
    <aspectRatio>4:3</aspectRatio>
    
    <transitions name="fadeAndSlide">
        <label>Default</label>
        <selectable>false</selectable>
        <systemToSystem>instant</systemToSystem>
        <systemToGamelist>slide</systemToGamelist>
        <gamelistToGamelist>slide</gamelistToGamelist>
        <gamelistToSystem>slide</gamelistToSystem>
        <startupToSystem>fade</startupToSystem>
        <startupToGamelist>fade</startupToGamelist>
    </transitions>

    <suppressTransitionProfiles>
        <entry>builtin-instant</entry>
        <entry>builtin-slide</entry>
        <entry>builtin-fade</entry>
    </suppressTransitionProfiles>

    <variant name="carousel-1">
        <label>Carousel 1</label>
        <selectable>true</selectable>
        <transitions>fadeAndSlide</transitions>
    </variant>

    <variant name="carousel-2">
        <label>Carousel 2</label>
        <selectable>true</selectable>
        <transitions>fadeAndSlide</transitions>
    </variant>

    <variant name="carousel-3">
        <label>Carousel 3</label>
        <selectable>true</selectable>
        <transitions>fadeAndSlide</transitions>
    </variant>

   <colorScheme name="artwork-cover">
      <label>Game Cover (Default)</label>
   </colorScheme>

   <colorScheme name="artwork-cover-rounded">
      <label>Game Cover (Default) [Rounded]</label>
   </colorScheme>

   <colorScheme name="artwork-cover-contain">
      <label>Game Cover (Aspect Ratio)</label>
   </colorScheme>

    <colorScheme name="artwork-cover-contain-rounded">
      <label>Game Cover (Aspect Ratio) [Rounded]</label>
   </colorScheme>

   <colorScheme name="artwork-cover-fill">
      <label>Game Cover (Stretch/Squash)</label>
   </colorScheme>

   <colorScheme name="artwork-cover-fill-rounded">
      <label>Game Cover (Stretch/Squash) [Rounded]</label>
   </colorScheme>

   <colorScheme name="artwork-3dbox">
      <label>Game 3dbox</label>
   </colorScheme>

   <colorScheme name="artwork-media">
      <label>Game Media</label>
   </colorScheme>

    <colorScheme name="artwork-miximage">
      <label>Game Miximage</label>
   </colorScheme>

   <colorScheme name="artwork-marquee">
      <label>Game Marquee</label>
   </colorScheme>

   

</themeCapabilities>

